  "tags": [
    {
      "name": "Recommendation Engine API",
      "description": "Context-Aware Recommendations for Prompts, Books, Habits, Meditation, Music, Exercise, Podcasts & Articles"
    }
  ],
  "paths": {
    "/api/v1/recommendations": {
      "get": {
        "tags": [
          "Recommendation Engine API"
        ],
        "summary": "Get personalized recommendations based on mood & journal history - if currentMood is omitted, it's computed from the caller's real recent journal entries",
        "operationId": "getRecommendations",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currentMood",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseMapStringObject"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recommendations/prompts": {
      "get": {
        "tags": [
          "Recommendation Engine API"
        ],
        "summary": "Get guided journal prompts by category",
        "operationId": "getPrompts",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "general"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListString"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
