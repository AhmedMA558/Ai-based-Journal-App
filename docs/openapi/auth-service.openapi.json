              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Authentication API"
        ],
        "summary": "Authenticate user and receive JWT tokens, or an MFA challenge if 2FA is enabled",
