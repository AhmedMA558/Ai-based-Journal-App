# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Required. Signs and verifies every JWT issued by auth-service and validated by every
# other service. Generate one with: openssl rand -base64 64
JWT_SECRET=

# Required. Encrypts TOTP (2FA) secrets at rest in auth-service's database - any
# length/format works, it's hashed into a valid AES-256 key. Generate one with:
# openssl rand -base64 64
TOTP_ENCRYPTION_KEY=

# Required by journal-service. Encrypts journal content at rest (AES/GCM) -
# a separate key from TOTP_ENCRYPTION_KEY, same generation approach.
# openssl rand -base64 64
JOURNAL_ENCRYPTION_KEY=

# Required for docker-compose.prod.yml (blank/unset is fine for local dev -
# TurnstileService treats a missing secret as "skip CAPTCHA verification", not
# a hard failure). Get both from the Cloudflare dashboard -> Turnstile -> your
# widget. The secret key is server-side only, auth-service's siteverify calls -
# never expose it to a client. The site key is public by design (it's embedded
# in the widget markup on web/mobile) but documented here since the two are a
# matched pair.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Required for docker-compose.prod.yml. Root password for the MySQL container.
MYSQL_ROOT_PASSWORD=

# docker-compose.yml (dev) defaults these to MailHog (mailhog:1025, no auth needed) -
# no action required for local dev. Required for docker-compose.prod.yml: point at a
# real SMTP provider (e.g. Brevo's free tier - 300 emails/day, no card required),
# since no MailHog container exists in prod. Auth and STARTTLS are hardcoded on in
# docker-compose.prod.yml, since virtually every real SMTP provider requires both.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
