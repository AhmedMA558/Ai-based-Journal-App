# Copy this file to .env and fill in real values. .env is gitignored - never commit it.

# Required. Signs and verifies every JWT issued by auth-service and validated by every
# other service. Generate one with: openssl rand -base64 64
JWT_SECRET=

# Required. Encrypts TOTP (2FA) secrets at rest in auth-service's database - any
# length/format works, it's hashed into a valid AES-256 key. Generate one with:
# openssl rand -base64 64
TOTP_ENCRYPTION_KEY=

# Required by journal-service. Encrypts journal content at rest (AES/GCM) -
# a separate key from TOTP_ENCRYPTION_KEY, same generation approach.
# openssl rand -base64 64
JOURNAL_ENCRYPTION_KEY=

# Required for docker-compose.prod.yml. Root password for the MySQL container.
MYSQL_ROOT_PASSWORD=
