# Pass A (default): "true" runs the app entirely against src/mocks/, no backend needed.
# Pass B: set to "false" and point EXPO_PUBLIC_API_BASE_URL at a real reachable gateway.
EXPO_PUBLIC_USE_MOCKS=true

# Gateway address for Pass B. "localhost" does not resolve to your dev machine from a
# physical device or most emulators - use your machine's LAN IP or a tunnel (e.g. ngrok).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional - Cloudflare Turnstile site key (public by design, safe to embed in a client
# build - EXPO_PUBLIC_ vars are baked into the app bundle). TurnstileGate.tsx falls back
# to this app's real production widget's site key if unset, so local dev works without
# configuring anything here.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
