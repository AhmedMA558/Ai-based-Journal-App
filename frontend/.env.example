# Copy this file to .env and fill in real values. .env is gitignored - never commit it.
# Vite only exposes vars prefixed VITE_ to client code (they end up in the built bundle,
# so never put a secret here - the Turnstile secret key lives only in auth-service's env).

# Optional - Cloudflare Turnstile site key (public by design, safe to embed in a client
# bundle). TurnstileWidget.tsx falls back to this app's real production widget's site key
# if this is unset, so local dev works without configuring anything here.
VITE_TURNSTILE_SITE_KEY=
